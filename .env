# Shared Codex launch defaults for Symphony itself.
#
# These values are read by sym-codex from the project root, not from
# .symphony/.env(.local). Override locally in .env.local or via the shell
# environment.

SYM_CODEX_MODEL=gpt-5.5
SYM_CODEX_REASONING_EFFORT=high

# Service-Tier für Symphony-Workflow-Starts.
SYM_CODEX_SERVICE_TIER=flex

# Service-Tier für manuelle sym-codex-Aufrufe.
SYM_CODEX_HUMAN_SERVICE_TIER=priority
